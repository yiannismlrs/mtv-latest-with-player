import axios from 'axios';

const API_BASE_URL = process.env.REACT_APP_API_URL || 'http://localhost:5000/api';
const VIDSRC_BASE_URL = process.env.REACT_APP_VIDSRC_BASE_URL || 'https://vidsrc.to';
const VIDSRC_EMBED_URL = process.env.REACT_APP_VIDSRC_EMBED_URL || `${VIDSRC_BASE_URL}/embed`;
const VIDSRC_API_URL = process.env.REACT_APP_VIDSRC_API_URL || `${VIDSRC_BASE_URL}/vapi`;

const api = axios.create({
  baseURL: API_BASE_URL,
  timeout: 10000,
});

// Movies API (TMDB backend from your server)
export const moviesAPI = {
  getPopular: (page = 1) => api.get(`/movies/popular?page=${page}`),
  getTrending: () => api.get('/movies/trending/day'),
  getDetails: (id) => api.get(`/movies/${id}`),
  search: (query, page = 1) => api.get(`/movies/search?query=${query}&page=${page}`)
};

// TV Shows API (TMDB backend from your server)
export const tvShowsAPI = {
  getPopular: (page = 1) => api.get(`/tvshows/popular?page=${page}`),
  getTrending: () => api.get('/tvshows/trending/day'),
  getDetails: (id) => api.get(`/tvshows/${id}`),
  getSeason: (id, season) => api.get(`/tvshows/${id}/season/${season}`),
  search: (query, page = 1) => api.get(`/tvshows/search?query=${query}&page=${page}`)
};

// Combined search
export const searchAPI = {
  combined: (query, page = 1) => api.get(`/search?query=${query}&page=${page}`)
};

// Download API
export const downloadAPI = {
  getLinks: (type, id, title, year) =>
    api.get(`/download?type=${type}&id=${id}&title=${title}&year=${year}`)
};

// VidSrc embed + vapi endpoints
export const vidSrcAPI = {
  // Movie embed (id must be IMDb or TMDB with tt prefix for IMDb)
  getMovieEmbedUrl: (id) => `${VIDSRC_EMBED_URL}/movie/${id}`,

  // TV show embed
  getTvEmbedUrl: (id) => `${VIDSRC_EMBED_URL}/tv/${id}.html`,

  // TV show season embed
  getTvSeasonEmbedUrl: (id, season) => `${VIDSRC_EMBED_URL}/tv/${id}/${season}`,

  // Latest movies
  getLatestMovies: (type = 'new', page = 1) =>
    `${VIDSRC_API_URL}/movie/${type}/${page}`,

  // Latest TV shows
  getLatestTv: (type = 'new', page = 1) =>
    `${VIDSRC_API_URL}/tv/${type}/${page}`,

  // Latest episodes
  getLatestEpisodes: (page = 1) =>
    `${VIDSRC_API_URL}/episode/latest/${page}`
};

// Utility functions for images
export const getImageUrl = (path, size = 'w500') => {
  if (!path) return '/placeholder-movie.jpg';
  return `https://image.tmdb.org/t/p/${size}${path}`;
};

export const getBackdropUrl = (path) => {
  if (!path) return '/placeholder-backdrop.jpg';
  return `https://image.tmdb.org/t/p/original${path}`;
};

export default api;
